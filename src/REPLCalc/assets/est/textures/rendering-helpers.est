# Rendering and camera helpers
# Display setup, raycasting, and visual effects

# Camera setup
so setup_camera() = {
  mid = floor(view_h / 2);
  fov = 1.05;
  max_d = 14;
  ray_step = 0.08;
  ray_steps = ceil(max_d / ray_step);
  ray_col_step = 1;
  floor_step = 1;
  ceil_step = 1;
  tex_res = 1;
  { mid, fov, max_d, ray_step, ray_steps, ray_col_step, floor_step, ceil_step, tex_res }
}

# 3D view rendering
so render_3d_view(map, px, py, yaw, w, h) = {
  cam = setup_camera();
  fill(0, 0, w, cam.mid, "muted");
  fill(0, cam.mid, w, h - cam.mid, "text");
  raycast_tex(map, px, py, yaw, cam.fov, h, cam.max_d, cam.ray_step, cam.ray_steps, cam.ray_col_step, { 
    floor_step: cam.floor_step; 
    ceil_step: cam.ceil_step; 
    tex_res: cam.tex_res 
  });
  cxh = floor(w / 2);
  cyh = floor(h / 2);
  line(cxh - 3, cyh, cxh + 3, cyh, "ok");
  line(cxh, cyh - 3, cxh, cyh + 3, "ok");
}

# Blueprint (2D) rendering
so render_blueprint_view(map, px, py, yaw, w, h) = {
  fill(0, 0, w, h, "muted");
  bs = 6;
  mw1 = mw(map);
  mh1 = mh(map);
  bx = floor((w - mw1 * bs) / 2);
  by = floor((h - mh1 * bs) / 2);
  duct_x = bx + floor((mw1 * bs) / 2);
  line(duct_x, by, duct_x, by + mh1 * bs, "accent");
  
  # Render map tiles
  for y in 0..(mh1 - 1):
    for x in 0..(mw1 - 1):
      tt = mget(map, x, y);
      px = bx + x * bs;
      py = by + y * bs;
      render_tile(tt, px, py, bs, duct_x, by);
  
  # Render player
  ppx = floor(bx + px * bs);
  ppy = floor(by + py * bs);
  fill(ppx - 1, ppy - 1, 3, 3, "accent-2");
  line(ppx, ppy, ppx + cos(yaw) * 6, ppy + sin(yaw) * 6, "accent-2");
}

# Individual tile rendering for blueprint
so render_tile(tt, px, py, bs, duct_x, by) = {
  if tt == 1:
    fill(px, py, bs, bs, "accent");
    fill(px + 1, py + 1, bs - 2, bs - 2, "muted");
    fill(px + 2, py + 2, bs - 4, bs - 4, "text");
    line(px + 2, py + 1, px + 2, py + bs - 2, "muted");
    line(px + 4, py + 1, px + 4, py + bs - 2, "muted");
  else:
    if tt == 2:
      fill(px, py, bs, bs, "warn");
      fill(px + 1, py + 1, bs - 2, bs - 2, "muted");
      line(px + 1, py + 1, px + bs - 2, py + bs - 2, "warn");
    else:
      if tile_wallish(tt) == 0: 0 else: 0

  if tt == 3:
    fill(px + 2, py + 2, 2, 2, "warn");
  else:
    if tt == 4:
      fill(px + 2, py + 2, 2, 2, "ok");
    else:
      if tt == 5:
        fill(px + 2, py + 2, 2, 2, "err");
      else:
        if tt == 8 || tt == 9 || tt == 12 || tt == 13 || tt == 16 || tt == 17 || tt == 18 || tt == 19:
          fill(px + 2, py + 2, 2, 2, if(tt == 8, "accent-2", "accent"));
          line(px + 3, py + 3, duct_x, py + 3, "accent");
        else:
          if tt == 10 || tt == 11:
            fill(px + 1, py + 1, bs - 2, bs - 2, "muted");
            rect(px + 1, py + 1, bs - 2, bs - 2, "accent-2");
          else:
            0
}

# HUD rendering
so render_hud(w, h, hp, ammo, armor, stamina, key, kills, money, view_mode) = {
  hy = h;
  fill(0, hy, w, hud_h, "transparent");
  rect(1, hy + 1, w - 2, hud_h - 2, "muted");

  # Health / ammo bars
  hpw = floor((w - 12) * (hp / 100));
  amw = floor((w - 12) * (ammo / 99));
  armw = floor((w - 12) * (armor / 100));
  stamw = floor((w - 12) * (stamina / 100));
  fill(6, hy + 1, armw, 1, "accent-2");
  fill(6, hy + 3, hpw, 3, if(hp < 30, "err", "ok"));
  fill(6, hy + 8, amw, 2, if(ammo < 8, "warn", "accent"));
  fill(6, hy + 10, stamw, 1, if(stamina < 20, "warn", "accent"));

  # Key indicator
  fill(2, hy + 3, 3, 3, if(key == 1, "warn", "muted"));

  # Kills indicator (up to 6 ticks)
  for k in 0..5:
    fill(2 + k * 3, hy + 8, 2, 2, if(kills > k, "ok", "muted"));

  # Status badge
  badge = if(doom_dead == 1, "err", if(doom_win == 1, "ok", if(key == 1, "warn", "accent-2")));
  fill(w - 7, hy + 3, 5, 7, badge);

  txt(w - 74, hy + 2, cat("E ", if(view_mode == 1, "BP", "3D")), "text", 1);
  txt(w - 32, hy + 2, cat("$", str(money)), "text", 1);
}
