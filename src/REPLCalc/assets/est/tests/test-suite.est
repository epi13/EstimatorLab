  t("compound feet inches literal", "6ft2in", expect_qty(6.166666666666667, "len", 0.000001)),
  ts("compound feet inches literal assignment", vec("wall = 8ft4in", "wall"), expect_qty(8.333333333333334, "len", 0.000001)),
  t("area unit token with digit", "12in2", expect_qty(0.08333333333333333, "area", 0.000001)),
