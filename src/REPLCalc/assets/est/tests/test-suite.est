so t(name, expr, expect) = record("name", name, "expr", expr, "expect", expect)
so ts(name, steps, expect) = record("name", name, "steps", steps, "expect", expect)
so expect_qty(value, kind, tol) = record("type", "qty", "value", value, "kind", kind, "tol", tol)
so expect_near(value, tol) = record("type", "scalar", "value", value, "tol", tol)
so expect_error(message) = record("type", "error", "message", message)
so expect_error_re(re, flags) = record("type", "error", "re", re, "flags", flags)
so expect_gfx(w, h) = record("type", "gfx", "w", w, "h", h)
so test_suite() = vec(
  t("basic arithmetic", "2+2", 4),
  t("operator precedence", "2+2*5", 12),
  t("parentheses", "(2+2)*5", 20),
  t("exponentiation", "2^3", 8),
  t("comparisons", "3 > 2", 1),
  t("logic", "1 && 0", 0),
  t("subtraction", "10-3", 7),
  t("division", "20/4", 5),
  t("combined ops", "18/3+2*4", 14),
  t("absolute value", "abs(-12)", 12),
  t("min max", "max(5, min(3, 9))", 5),
  t("rounding", "round(2.6)", 3),
  t("ceil", "ceil(2.1)", 3),
  t("floor", "floor(2.9)", 2),
  t("sqrt", "sqrt(81)", 9),
  t("pow function", "pow(3, 4)", 81),
  t("log/exp", "log(exp(2))", expect_near(2, 0.000001)),
  t("sine", "sin(pi / 2)", expect_near(1, 0.000001)),
  t("atan2", "atan2(1, 1)", expect_near(0.7853981633974483, 0.000001)),
  t("clamp", "clamp(12, 0, 10)", 10),
  t("if function", "if(3>2, 7, 4)", 7),
  t("repeat loop", "repeat(5, 0, \"state + 2\")", 10),
  t("while_budget stops", "while_budget(100, \"state < 5\", 0, \"state + 1\")", 5),
  t("while_budget respects budget", "while_budget(3, \"1\", 0, \"state + 1\")", 3),
  ts("witness push/pop", vec("witness_push(\"a\", 42)", "witness_pop(\"a\")"), 42),
  ts("audit alias push/pop", vec("audit_add(\"x\", 9)", "audit_take(\"x\")"), 9),
  ts("witness tag mismatch", vec("witness_push(\"a\", 42)", "witness_pop(\"b\")"), expect_error_re("tag mismatch", "i")),
  t("trace passthrough", "trace(7, \"dbg\") + 1", 8),
  t("rec get field", "get(rec(1,2,3,4,5,6,7), \"cursor\")", 5),
  t("record get field", "get(record(\"cursor\", 9, \"flags\", 2), \"flags\")", 2),
  t("set record field", "get(set(rec(1,2,3,4,5,6,7), \"cursor\", 11), \"cursor\")", 11),
  ts("set var still works", vec("set(\"x\", 12)", "get(\"x\")"), 12),
  t("len string", "len(\"abc\")", 3),
  t("char_code in range", "char_code(\"A\", 0)", 65),
  t("char_code out of range", "char_code(\"A\", 2)", -1),
  t("charclass digit", "charclass(char_code(\"7\", 0))", 1),
  t("charclass alpha", "charclass(char_code(\"Z\", 0))", 2),
  t("class alias works", "class(char_code(\"-\", 0))", 4),
  t("scan returns code", "field(scan(\"A\", 0), \"code\")", 65),
  t("scan returns cls", "field(scan(\"A\", 0), \"cls\")", 2),
  t("scan increments i", "field(scan(\"A\", 0), \"i\")", 1),
  t("scan_while digits text", "field(scan_while(\"123abc\", 0, \"cls==1\"), \"text\")", "123"),
  t("scan_while digits index", "field(scan_while(\"123abc\", 0, \"cls==1\"), \"i\")", 3),
  t("take_while digits", "take_while(\"123abc\", 0, \"cls==1\")", "123"),
  t("scan_while accumulator atoi", "field(scan_while(\"123\", 0, \"cls==1\", 0, \"acc*10 + (code-48)\"), \"acc\")", 123),
  t("floor_div negative", "floor_div(-1, 4)", -1),
  t("mod_floor negative", "mod_floor(-1, 4)", 3),
  t("mod_pos negative", "mod_pos(-1, 4)", 3),
  t("mod_pos handles negative modulus", "mod_pos(5, -4)", 1),
  t("lane_mod works", "lane_mod(-1, 4)", 3),
  t("packN/unpackN roundtrip", "packN(unpackN(12345, vec(97, 89, 83, 79)), vec(97, 89, 83, 79))", 12345),
  t("unpackN length", "field(unpackN(0, vec(5, 7, 11)), \"v3\")", 0),
  t("packN normalizes digits", "packN(vec(-1, 7), vec(5, 7))", 4),
  t("argmax4 chooses best", "argmax4(1, 5, 3, 4)", 1),
  t("argmin4 chooses best", "argmin4(1, -5, 3, 4)", 1),
  t("argmax4 tie picks first", "argmax4(5, 5, 1, 5)", 0),
  t("select_best4 pair form", "field(select_best4(\"a\", 1, \"b\", 3, \"c\", 2, \"d\", 0), \"lane\")", 1),
  t("split_ratio base field", "field(split_ratio(1000, 2), \"base\")", expect_near(333.3333333333333, 0.000001)),
  ts("select_best4 candidate assy form", vec("c0 = record(\"state\", \"a\", \"score\", 1)", "c1 = record(\"state\", \"b\", \"score\", 3)", "c2 = record(\"state\", \"c\", \"score\", 2)", "c3 = record(\"state\", \"d\", \"score\", 0)", "field(select_best4(c0, c1, c2, c3), \"state\")"), "b"),
  t("bit ops band", "band(6, 3)", 2),
  t("bit ops bor", "bor(6, 3)", 7),
  t("bit ops bxor", "bxor(6, 3)", 5),
  t("bit ops bnot", "bnot(0)", 4294967295),
  t("bit ops shl", "shl(1, 5)", 32),
  t("bit ops shr", "shr(32, 5)", 1),
  t("flag set+has on", "flag_has(flag_set(0, 4, 1), 4)", 1),
  t("flag set+has off", "flag_has(flag_set(4, 4, 0), 4)", 0),
  t("pi constant", "pi * 2", expect_near(6.283185307179586, 0.000001)),
  ts("assignment + reference", vec("x = 10", "x * 3"), 30),
  ts("variable reassignment", vec("x = 5", "x = x + 2", "x"), 7),
  t("unit addition", "12 in + 1 ft", expect_qty(2, "len", 0.000001)),
