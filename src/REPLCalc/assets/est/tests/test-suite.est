  ts("prod(rate, duration)", vec("r = rate(\"place\", 50 sfph, {crew: 3})", "to_sf(prod(r, 2 hr))"), expect_near(300, 0.000001)),
  ts("time_for(qty, rate) computes duration", vec("r = rate(\"place\", 100 sfph, {crew: 2})", "t = time_for(400 sf, r)", "to_hr(t)"), expect_near(2, 0.000001)),
  ts("rate_inv(rate) inverts a rate object", vec("r = rate(\"place\", 100 sfph, {crew: 2})", "rinv = rate_inv(r)", "to_hr( prod(rinv, 200 sf) )"), expect_near(1, 0.000001)),
  ts("crew(count, rate) scales rate object", vec("r = rate(\"place\", 50 sfph, {crew: 2})", "r2 = crew(3, r)", "to_sf(prod(r2, 1 hr))"), expect_near(300, 0.000001)),
