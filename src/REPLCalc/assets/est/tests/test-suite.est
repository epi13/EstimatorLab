  ts("meta-defined function + eval + methods registry consistency", vec("define(\"adder\", \"a,b\", \"a+b\")", "define(\"mul3\", \"x\", \"x*3\")", "so square(x) = x ^ 2", "value = eval(\"adder(2,3) + mul3(4) + square(5)\")", "names = methods()", "check = if(value == 42 && names == \"adder, mul3, square\", 1, 0)", "check"), 1),
  ts("nested meta get/set drives rate model inside user solutions", vec("set(\"rate_base\", 50)", "set(\"burden_pct\", 18)", "set(\"markup_pct\", 12)", "so loaded_rate() = burden(get(\"rate_base\"), get(\"burden_pct\"))", "total = 0", "for crew in 1..4: total = total + (loaded_rate() * (8 + crew))", "result = round(markup(total, get(\"markup_pct\")) * 100) / 100", "result"), expect_near(2775.36, 0.000001)),
