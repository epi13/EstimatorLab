  ts("scenario compare returns delta", vec("base = scenario(\"base\", {qty: 100, unit: 2.5, total: qty * unit})", "alt = scenario(\"alt\", {qty: 120, unit: 2.5, total: qty * unit})", "cmp = sc_compare(base, alt, \"total\", \"cmp\")", "field(cmp, \"delta\")"), 50),
