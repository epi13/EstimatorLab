  ts("for loop descending", vec("total = 0", "for i in 5..1 step -2: total = total + i", "total"), 9),
  ts("for loop unit range", vec("total = 0 ft", "for i in 1 ft..3 ft: total = total + i", "total"), expect_qty(6, "len", 0.000001)),
  ts("repeat loop", vec("total = 0", "repeat 3: total = total + 2", "total"), 6),
  ts("repeat loop with units", vec("total = 0 ft", "repeat 3: total = total + 2 ft", "total"), expect_qty(6, "len", 0.000001)),
  t("equation solver", "56 cy = concrete_cy(sf, 6 in)", 3024),
  t("equation solver larger", "100 cy = concrete_cy(sf, 8 in)", 4050),
  ts("nested markup loop total", vec("so item_cost(rate, hours, waste_pct) = markup(rate * hours, waste_pct)", "total = 0", "for crew in 1..3: total = total + item_cost(45 + crew * 5, 8 + crew, 10)", "if total > 0: total = round(total) else: total = 0", "total"), 1826),
  ts("looped unit accumulation", vec("total = 0 ft", "for i in 1..5: total = total + (i * (2 ft))", "total"), expect_qty(30, "len", 0.000001)),
  ts("area waste rounding chain", vec("base = area_rect(45 ft, 30 ft)", "with_waste = waste(base, 12.5)", "with_waste_sy = to_sy(with_waste)", "round_up(with_waste_sy, 5)"), 170),
  ts("bay area loop accumulation", vec("so bay_area(span, bays) = area_rect(span, 20 ft) * bays", "total = 0 sf", "for i in 1..4: total = total + bay_area(15 ft + i ft, i)", "total"), expect_qty(3600, "area", 0.000001)),
  ts("conditional scoring loop", vec("score = 0", "for i in 1..6: if i > 3 && i < 6: score = score + i else: score = score + (i * 2)", "score"), 33),
  ts("repeat bump function", vec("so bump(x) = x * 1.1 + 3", "val = 0", "repeat 4: val = bump(val)", "val"), expect_near(13.923, 0.000001)),
  ts("trench volume to cy", vec("so trench_vol(len, width, depth) = vol_rect(area_rect(len, width), depth)", "volume = trench_vol(120 ft, 3 ft, 2 ft)", "to_cy(volume)"), expect_near(26.6666666667, 0.000001)),
  ts("eval with variables", vec("x = 12", "y = 3", "eval(\"x^2 + y^3 + 2*x*y\")"), 243),
  ts("unit comparisons with if", vec("total = 0 ft", "if 2 ft > 1 ft: total = total + 3 ft else: total = total + 5 ft", "if total >= 3 ft: total = total + 2 ft else: total = total + 1 ft", "total"), expect_qty(5, "len", 0.000001)),
  t("log sqrt trig compound", "log(exp(3)) + sqrt(144) - (sin(pi/6)^2 + cos(pi/6)^2)", expect_near(14, 0.000001)),
  t("unit cost with markup and burden", "unit(markup(200, 15) + burden(80, 25), 4)", 82.5),
