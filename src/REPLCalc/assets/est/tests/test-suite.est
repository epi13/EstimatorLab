  ts("pcost sums task costs", vec("p = project(\"demo\")", "ptask(p, \"A\", {dur: 2 hr, cost: 1000 $})", "ptask(p, \"B\", {dur: 1 hr, cost: 500 $})", "to(pcost(p), usd)"), 1500),
