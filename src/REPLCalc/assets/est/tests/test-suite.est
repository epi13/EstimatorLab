  ts("wall area from perim", vec("p = perim_rect(10 ft, 5 ft)", "wall_area(p, 8 ft)"), expect_qty(240, "area", 0.000001)),
  t("oc linear ft", "oc_linear_ft(500 sf, 6 in)", expect_qty(1000, "len", 0.000001)),
