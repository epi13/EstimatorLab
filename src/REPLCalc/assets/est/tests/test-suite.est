  t("clamp qty", "clamp(12 ft, 0 ft, 10 ft)", expect_qty(10, "len", 0.000001)),
  ts("user solution", vec("so crew_cost(rate, hours) = rate * hours", "crew_cost(85, 12)"), 1020),
  ts("user solution with units", vec("so wall_area_calc(len, ht) = len * ht", "wall_area_calc(12 ft, 8 ft)"), expect_qty(96, "area", 0.000001)),
  ts("define meta function", vec("define(\"adder\", \"a,b\", \"a+b\")", "adder(4, 6)"), 10),
  ts("methods listing", vec("define(\"double\", \"x\", \"x*2\")", "methods()"), "double"),
  ts("vars listing", vec("a = 1", "b = 2", "vars()"), "a, b"),
  ts("meta helpers", vec("set(\"crew\", 5)", "get(\"crew\")"), 5),
  ts("unset meta", vec("set(\"crew\", 5)", "unset(\"crew\")"), 1),
  ts("eval expression", vec("eval(\"2+3*4\")"), 14),
  ts("undefine solution", vec("define(\"temp\", \"x\", \"x+1\")", "undefine(\"temp\")"), 1),
  ts("if statement", vec("total = 0", "if 3 > 2: total = 5 else: total = 2", "total"), 5),
  ts("nested if statement", vec("total = 0", "if 2 > 3: total = 1 else: if 4 > 2: total = 7 else: total = 3", "total"), 7),
  ts("for loop", vec("total = 0", "for i in 1..4: total = total + i", "total"), 10),
