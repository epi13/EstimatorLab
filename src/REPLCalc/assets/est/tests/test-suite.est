  ts("dlss-lite performance mode with debug path executes", vec("gfx(24, 16)", "gfxs(2)", "doom_dlss_lite = \"performance\"", "doom_dlss_debug = 1", "doom_dlss_blend = 0.4", "gfxloop(\"cls(); set('dlss_perf_hash', frame * 13 + 7)\")", "gfxstep(4)", "get(\"dlss_perf_hash\")"), 59),
  ts("traversal-first turboquant + raycast stability harness", vec("gfx(80, 45)", "gfxs(2)", "tqprofile(\"balanced\")", "doom_dlss_lite = \"quality\"", "doom_dlss_debug = 0", "m = map(\"########|#S.....#|#.###..#|#...#..#|#..E#..#|########\")", "x = mspawnx(m)", "y = mspawny(m)", "gfxloop(\"cls(); r = raycast(m, x, y, frame * 0.03, 1.0, 30, 12, 0.08, 48, 2); set('rq_hash', round((r + frame) * 1000))\")", "gfxfps(30)", "gfxstep(0)", "h0 = get(\"rq_hash\")", "gfxstep(1)", "h1 = get(\"rq_hash\")", "gfxstep(10)", "h11 = get(\"rq_hash\")", "gfxrewind(11)", "h0b = get(\"rq_hash\")", "if(h1 != h0 && h11 != h1 && abs(h0b - h0) < 1e-9, 1, 0)"), 1),
