# Map traversal and analysis utilities
# Functions for traversing and analyzing 2D grid maps

# Map dimensions
so map_width(map) = mw(map)
so map_height(map) = mh(map)

# Coordinate validation
so in_bounds(map, x, y) = x >= 0 && y >= 0 && x < map_width(map) && y < map_height(map)

# Safe tile access with bounds checking
so safe_get(map, x, y) = if(in_bounds(map, x, y), mget(map, x, y), 0)

# Count tiles of specific type
so count_tiles(map, tile_type) = {
  count = 0;
  w = map_width(map);
  h = map_height(map);
  for y in 0..(h - 1):
    for x in 0..(w - 1):
      if mget(map, x, y) == tile_type: count = count + 1 else: 0
  count
}

# Find all positions of a tile type
so find_tiles(map, tile_type) = {
  positions = [];
  w = map_width(map);
  h = map_height(map);
  for y in 0..(h - 1):
    for x in 0..(w - 1):
      if mget(map, x, y) == tile_type: positions = positions + [{x: x, y: y}] else: 0
  positions
}

# Get neighboring tiles (8-directional)
so get_neighbors(map, x, y) = {
  neighbors = [];
  for dx in -1..1:
    for dy in -1..1:
      if dx == 0 && dy == 0: 0 else:
        nx = x + dx;
        ny = y + dy;
        if in_bounds(map, nx, ny): neighbors = neighbors + [{x: nx, y: ny, tile: mget(map, nx, ny)}] else: 0
  neighbors
}

# Count tiles matching a predicate
so count_if(map, predicate) = {
  count = 0;
  w = map_width(map);
  h = map_height(map);
  for y in 0..(h - 1):
    for x in 0..(w - 1):
      if predicate(mget(map, x, y)): count = count + 1 else: 0
  count
}

# Find tiles matching a predicate
so find_if(map, predicate) = {
  positions = [];
  w = map_width(map);
  h = map_height(map);
  for y in 0..(h - 1):
    for x in 0..(w - 1):
      if predicate(mget(map, x, y)): positions = positions + [{x: x, y: y}] else: 0
  positions
}

# Flood fill from a starting position
so flood_fill(map, start_x, start_y, predicate) = {
  visited = [];
  queue = [{x: start_x, y: start_y}];
  result = [];
  
  while len(queue) > 0:
    pos = queue[0];
    queue = queue[1..];
    
    if has_item(visited, pos) == 0 && in_bounds(map, pos.x, pos.y) && predicate(mget(map, pos.x, pos.y)):
      visited = visited + [pos];
      result = result + [pos];
      
      neighbors = get_neighbors(map, pos.x, pos.y);
      for n in neighbors:
        queue = queue + [{x: n.x, y: n.y}];
    else:
      0
  
  result
}
